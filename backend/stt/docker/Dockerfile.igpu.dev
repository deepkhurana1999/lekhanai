# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Stage: deps — shared setup used by every downstream stage.
# Clones submodules, downloads models. No app source yet (kept separate so
# source edits don't invalidate this expensive layer).
# ---------------------------------------------------------------------------
FROM debian:trixie-slim AS deps

# Update package lists and install dependencies
RUN apt-get update && apt-get install -y \
    libcpprest-dev \
    curl \
    wget \
    bash \
    gdb \
    cmake \
    libssl-dev \
    zlib1g-dev \
    build-essential \
    libboost-all-dev \
    git \
    nlohmann-json3-dev \
    libopenblas-dev \
    pkg-config \
    ca-certificates \
    gnupg \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install ONNX Runtime (for Silero VAD support)
RUN apt-get update && apt-get install -y \
    libonnxruntime-dev \
    || echo "ONNX Runtime dev package not available, using pip version"

WORKDIR /app

# Initialize git and clean up
RUN git init

# Add git submodules
RUN git submodule add https://github.com/deepkhurana1999/whisper.cpp.git ./libraries/whisper.cpp
RUN git submodule add https://github.com/paullouisageneau/libdatachannel.git ./libraries/libdatachannel
RUN git submodule add https://github.com/jmont-dev/ollama-hpp.git ./libraries/ollama-hpp
RUN git submodule update --init --recursive

# Checkout specific versions
RUN cd libraries/libdatachannel && git checkout v0.23.2
RUN cd libraries/whisper.cpp && git fetch origin && git switch v1.8.0_parallel
RUN cd libraries/ollama-hpp && git checkout v0.9.7

# Create models directory and download whisper model
RUN mkdir /models
RUN /app/libraries/whisper.cpp/models/download-ggml-model.sh small.en-q5_1 /models

# Download Silero VAD model for Voice Activity Detection
RUN mkdir -p /models/vad && \
    wget -O /models/vad/silero_vad.onnx \
    https://github.com/snakers4/silero-vad/raw/master/src/silero_vad/data/silero_vad.onnx

# Copy application files
# Use a build argument to bust cache for application files
ARG CACHEBUST=1
RUN echo "Cache bust: $CACHE_BUST"
COPY ./backend/stt/include /app/include
COPY ./backend/stt/src /app/src
COPY ./backend/stt/CMakeLists.txt /app/CMakeLists.txt
COPY ./backend/stt/entrypoint.sh /app/entrypoint.sh

# ---------------------------------------------------------------------------
# Stage: cpu-runtime — original dev workflow, unchanged.
# Compiles at CONTAINER START (via entrypoint.sh), not at image build time.
# Kept for reference / CPU-only fallback; not the default build target.
# ---------------------------------------------------------------------------
FROM deps AS cpu-runtime
ENTRYPOINT [ "bash", "/app/entrypoint.sh" ]

# ---------------------------------------------------------------------------
# Stage: sycl-runtime — builds AND runs on Intel's own official oneAPI
# basekit image.
# ---------------------------------------------------------------------------
FROM intel/oneapi-basekit:2025.1.1-0-devel-ubuntu24.04 AS sycl-runtime

RUN apt-get update && apt-get install -y \
    libcpprest-dev \
    libwebsocketpp-dev \
    nlohmann-json3-dev \
    libopenblas-dev \
    libboost-all-dev \
    ca-certificates \
    git \
    wget \
    ccache \
    && rm -rf /var/lib/apt/lists/*

# Adding ONNX Runtime dev package
RUN wget -qO /tmp/onnxruntime.tgz \
    https://github.com/microsoft/onnxruntime/releases/download/v1.21.0/onnxruntime-linux-x64-1.21.0.tgz \
    && tar -xzf /tmp/onnxruntime.tgz -C /opt \
    && mv /opt/onnxruntime-linux-x64-1.21.0 /opt/onnxruntime \
    && rm /tmp/onnxruntime.tgz \
    && ln -s lib /opt/onnxruntime/lib64 \
    && ln -s . /opt/onnxruntime/include/onnxruntime
ENV CMAKE_PREFIX_PATH=/opt/onnxruntime:${CMAKE_PREFIX_PATH}
RUN echo /opt/onnxruntime/lib > /etc/ld.so.conf.d/onnxruntime.conf && ldconfig

WORKDIR /app
RUN git init
RUN git submodule add https://github.com/deepkhurana1999/whisper.cpp.git ./libraries/whisper.cpp
RUN git submodule add https://github.com/paullouisageneau/libdatachannel.git ./libraries/libdatachannel
RUN git submodule add https://github.com/jmont-dev/ollama-hpp.git ./libraries/ollama-hpp
RUN git submodule update --init --recursive
RUN cd libraries/libdatachannel && git checkout v0.23.2
RUN cd libraries/whisper.cpp && git fetch origin && git switch v1.8.0_parallel
RUN cd libraries/ollama-hpp && git checkout v0.9.7

RUN mkdir /models
RUN /app/libraries/whisper.cpp/models/download-ggml-model.sh small.en-q5_1 /models
RUN mkdir -p /models/vad && \
    wget -O /models/vad/silero_vad.onnx \
    https://github.com/snakers4/silero-vad/raw/master/src/silero_vad/data/silero_vad.onnx

ARG CACHEBUST=1
RUN echo "Cache bust: $CACHE_BUST"
COPY ./backend/stt/include /app/include
COPY ./backend/stt/src /app/src
COPY ./backend/stt/CMakeLists.txt /app/CMakeLists.txt

# ccache + a BuildKit cache mount, so later flag/source tweaks don't
# recompile the entire project from scratch every time (see git history for
# how much this mattered during SYCL debugging).
SHELL ["/bin/bash", "-c"]
ENV CCACHE_DIR=/ccache
RUN --mount=type=cache,target=/ccache \
    source /opt/intel/oneapi/setvars.sh --force \
    && cmake -B build -DCMAKE_BUILD_TYPE=Release -DENABLE_SYCL=ON -DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx \
    -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    && cmake --build build -j --config Release \
    && ccache -s

ENTRYPOINT [ "/app/build/stt" ]
