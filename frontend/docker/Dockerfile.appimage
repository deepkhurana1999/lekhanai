# syntax=docker/dockerfile:1
#
# Build-only image: compiles the Tauri app and produces a Linux AppImage
# without installing any GTK/WebKitGTK/Rust toolchain on the host. GTK's
# build-time linking only needs headers/.pc files present, not a running
# display, so this works fine in a headless container.
FROM ubuntu:24.04 AS builder

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    curl \
    wget \
    file \
    build-essential \
    libssl-dev \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    librsvg2-dev \
    libayatana-appindicator3-dev \
    libxdo-dev \
    libasound2-dev \
    ca-certificates

# Rust toolchain (not present in the base image, unlike the host)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# pnpm — pinned to major version 10
RUN curl -fsSL https://get.pnpm.io/install.sh | env PNPM_VERSION=10.33.4 PNPM_HOME="/root/.local/share/pnpm" SHELL="/bin/bash" sh -
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="${PNPM_HOME}/bin:${PNPM_HOME}:${PATH}"

# pnpm's own CLI is a standalone binary
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y nodejs xdg-utils

WORKDIR /app
COPY . .

# pnpm's own content-addressable store is cacheable across builds even
# though the lockfile/COPY layer above busts on every source change.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/app/src-tauri/target,sharing=locked \
    pnpm tauri build \
    && mkdir -p /output \
    && cp -r /app/src-tauri/target/release/bundle /output/bundle

RUN cd /output/bundle/appimage \
    && APPIMAGE=$(ls *.AppImage) \
    && chmod +x "$APPIMAGE" \
    && ./"$APPIMAGE" --appimage-extract >/dev/null \
    && rm -f squashfs-root/usr/lib/libwayland-client.so.0 \
    squashfs-root/usr/lib/libwayland-egl.so.1 \
    squashfs-root/usr/lib/libwayland-cursor.so.0 \
    squashfs-root/usr/lib/libwayland-server.so.0 \
    && find squashfs-root -iname "im-wayland.so" -delete \
    && wget -qO appimagetool https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage \
    && chmod +x appimagetool \
    && ./appimagetool --appimage-extract-and-run squashfs-root "$APPIMAGE" \
    && rm -rf squashfs-root appimagetool

FROM scratch AS export
COPY --from=builder /output/bundle/appimage/*.AppImage /
